# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment and Secret Files
.env*
!.env.example

# Service Account and Credential Keys
*service-account*.json
*credentials*.json
*key*.json
*.pem
*.key
gcp-key*.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test coverage output
coverage/

# Terragrunt generates these into each leaf at run time
infra/**/.terragrunt-cache/
infra/**/backend.tf
infra/**/provider.tf
infra/**/versions.tf
# Modules commit their own versions.tf (tflint requires one); only leaves generate it
!infra/modules/**/versions.tf
infra/**/.terraform/
# Leaf lock files are generated per run; only modules commit one
infra/live/**/.terraform.lock.hcl
