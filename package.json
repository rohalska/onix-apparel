{
  "name": "clothing-store",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "prepare": "node -e \"const f='scripts/installHooks.mjs';if(require('node:fs').existsSync(f))require('node:child_process').execFileSync(process.execPath,[f],{stdio:'inherit'})\"",
    "hooks": "node scripts/installHooks.mjs --force",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1 --port 5173",
    "dev:server": "node server/proxy.mjs",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "preview": "vite preview",
    "export:vertex": "node scripts/exportVertexCatalog.mjs",
    "lint": "eslint . --max-warnings=17",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fullstory/browser": "^2.1.2",
    "canvas-confetti": "^1.9.4",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^25.0.1",
    "lefthook": "^2.1.15",
    "postcss": "^8.4.49",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.9"
  }
}
