# Server Configuration
PORT=3001

# Google Cloud Vertex AI Search for Retail Configuration
# (Leave blank or unset to run in Local Mock/Simulation Mode)
GCP_PROJECT_ID=
GCP_LOCATION=global
GCP_CATALOG_ID=default_catalog
GCP_SERVING_CONFIG_ID=default_search

# Authentication & Secrets Best Practices:
# - Production (Cloud Run / GKE): Source secrets from Secret Manager or Workload Identity.
#   Native ADC uses the Google Cloud Compute Metadata Server token automatically.
#   Do NOT place service account JSON keys or credential files in this repository.
# - Local Development: Authenticate securely via Application Default Credentials:
#   `gcloud auth application-default login`
